{
    "name": "LinkStart",
    "description": "开始游戏并切换区服",
    "task": [
        {
            "taskId": "task_start_game",
            "taskName": "开始游戏",
            "taskType": "custom",
            "timeout": 10000,
            "retryCount": 1,
            "label": "启动！砍斯汀我踏马来了",
