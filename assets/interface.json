{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaSaS",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaSaS!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/WxhnQuXihe/MaaSaS",
    "version": "0.0.1",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "雷霆",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [],
    "option": {},
    "import": [
        "./pipeline/start.json",
        "./pipeline/副本.json"
    ],
    "preset": [
        {
            "name": "标准",
            "task": [
                {
                    "name": "LinkStart",
                    "enabled": true
                }
            ]
        }
    ]
}