{
    "StartGame": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.leiting.zjcs"
            }
        },
        "rate_limit": 5000,
        "timeout": 72000,
        "post_delay": 500,
        "next": [
            "MatchAnnounce"
        ]
    },
    "MatchAnnounce": {
        "template": "homePageAnnouncement.png",
        "recognition": "TemplateMatch",
        "threshold": 0.7,
        "method": 5,
        "next": [
            "matchBack"
        ]
    },
    "matchBack": {
        "template": "back.png",
        "recognition": "TemplateMatch",
        "threshold": 0.7,
        "method": 5,
        "post_delay": 1000,
        "next": [
            "closeAnnouncement"
        ]
    },
    "closeAnnouncement": {
        "action": "Click",
        "target": "matchBack",
        "next": [
            "enterTheGame"
        ]
    },
    "enterTheGame": {
        "template": "enterGame.png",
        "recognition": "TemplateMatch",
        "threshold": 0.7,
        "method": 5,
        "next": [
            "clickEnterGame"
        ]
    },
    "clickEnterGame": {
        "action": "Click",
        "target_offset": [
            344,
            971,
            1,
            1
        ],
        "repeat": 3
    }
}