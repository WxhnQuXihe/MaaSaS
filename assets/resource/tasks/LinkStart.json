                    "type": "object",
                    "properties": {
                        "server_name": {
                            "type": "string",
                            "title": "服务器名称",
                            "description": "请输入要切换的游戏服务器名称",
                            "default": "",
                            "required": true
                        }
                    },
                    "required": [
                        "server_name"
                    ],
                    "configs": [
                        {
                            "key": "server_name",
                            "label": "服务器名称",
                            "type": "input",
                            "placeholder": "输入你的服务器四字名称",
                            "required": true,
                            "defaultValue": "",
                            "pipeline_override": {
                                "切换服务器": {
                                    "expected": "{server_name}"
                                }
                            }
                        }
                    ]
                }
            }
        }
    ]
